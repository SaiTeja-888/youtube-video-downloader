# POSTLINK backend environment
# Copy to backend/.env for local development, or set these variables in your cloud host.

PROJECT_NAME=POSTLINK media downloader API
SECRET_KEY=change-this-to-a-long-random-secret

# Public frontend URLs allowed to call the API. Use comma-separated values.
BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app
BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Database. On Render/Railway/etc, prefer the platform-provided DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Storage directory. Use a persistent disk path on production hosts.
DOWNLOAD_DIR=./downloads

# Optional cache/queue services. The app falls back to local mode when these are absent.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional, for login-gated YouTube/Instagram media on a trusted private deployment.
# COOKIES_FROM_BROWSER=chrome
